# ============================================
# A Great Escape - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ---- Database (Required) ----
# For local development with SQLite:
# DATABASE_URL=file:./dev.db
# For Railway/Production with PostgreSQL:
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# ---- Authentication (Required) ----
# Generate a secure random string: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# ---- Admin Seeding (Required for first seed) ----
# Used by npm run seed to create or confirm the default admin user.
ADMIN_EMAIL=admin@greatescapemn.com
ADMIN_PASSWORD=change-this-before-production

# ---- Booking Email Automation (Optional) ----
# When set, booking requests still save to the database and also send:
# - admin booking alerts
# - customer request confirmations
# - customer confirmed-booking emails
# - waiver/payment reminder emails from admin
# - .ics calendar attachments when date/time is available
# Resend is supported by default: https://resend.com
RESEND_API_KEY=
BOOKING_NOTIFICATION_EMAIL=admin@greatescapemn.com
EMAIL_FROM="A Great Escape <bookings@yourdomain.com>"
REMINDER_AUTOMATION_SECRET=

# ---- Stripe (Optional - configure in Admin Panel instead) ----
# Payment keys are stored in the database via Admin > Payment Settings
# But you can also set these as fallback env vars:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- PayPal (Optional - configure in Admin Panel instead) ----
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# ---- Next.js ----
NEXT_PUBLIC_SITE_URL=https://greatescapemn.com
