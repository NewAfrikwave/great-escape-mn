# Local development uses PostgreSQL via Docker Compose
# Run: docker compose up -d
# For Railway/Production, set DATABASE_URL in Railway env vars
DATABASE_URL=postgresql://greatescapemn:greatescapemn@localhost:5432/greatescapemn?schema=public

# Authentication - REQUIRED for production
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-secret-key-change-in-production

# Admin seeding
ADMIN_EMAIL=admin@greatescapemn.com
ADMIN_PASSWORD=admin123
